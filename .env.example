# ──────────────────────────────────────────────────────────────────
# Agent harness and NVIDIA inference
# ──────────────────────────────────────────────────────────────────
# Supported upstream agents: openclaw (default), hermes, or
# langchain-deepagents-code. Hermes names must be 19 characters or fewer.
# NEMOCLAW_AGENT=openclaw
# NEMOCLAW_SANDBOX_NAME=my-assistant

# Canonical upstream key. NVIDIA_API_KEY remains accepted as a compatibility
# alias by the cookbook.
NVIDIA_INFERENCE_API_KEY=nvapi-your-key-here
# NVIDIA_API_KEY=nvapi-your-key-here

# Inference provider (optional — defaults to NVIDIA cloud)
# Valid values: build (NVIDIA cloud), openai, anthropic, anthropicCompatible,
#               gemini, ollama, custom, nim-local, vllm
# NEMOCLAW_PROVIDER=build

# Inference model (optional — defaults to nvidia/nemotron-3-super-120b-a12b)
# Must match the provider. You can switch at runtime without rebuilding:
#   openshell inference set --provider nvidia-prod --model <model>
# NEMOCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b

# Custom inference endpoint (optional — for custom/nim-local/vllm providers)
# NEMOCLAW_ENDPOINT_URL=http://localhost:8000/v1

# Sandbox resources (optional)
# View upstream profiles with: nemoclaw resources
# NEMOCLAW_RESOURCE_PROFILE=developer
# NEMOCLAW_CPU=75%
# NEMOCLAW_RAM=75%

# Alternative inference provider keys (optional — set with matching NEMOCLAW_PROVIDER)
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ──────────────────────────────────────────────────────────────────
# Messaging (optional)
# ──────────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# TELEGRAM_ALLOWED_IDS=your-chat-id-from-userinfobot  # comma-separated; restricts who can DM the bot
# TELEGRAM_REQUIRE_MENTION=1                          # group chats only; 1 requires @mention, 0 replies to all group messages
# TELEGRAM_GROUP_POLICY=allowlist                     # open (upstream default), allowlist, or disabled
# DISCORD_BOT_TOKEN=your-discord-bot-token
# DISCORD_SERVER_ID=your-discord-server-id
# DISCORD_ALLOWED_IDS=your-discord-user-id            # comma-separated; DISCORD_USER_ID also works upstream
# DISCORD_REQUIRE_MENTION=1                           # 1 requires @mention, 0 replies to all configured server messages
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_APP_TOKEN=xapp-your-slack-app-token            # required by upstream Slack Socket Mode
# SLACK_ALLOWED_USERS=U012ABCDEF,U987ZYXW              # optional member allowlist
# SLACK_ALLOWED_CHANNELS=C012AB3CD,C987ZY6XW           # optional channel allowlist for @mentions
# WECHAT_ALLOWED_IDS=wxid-optional-allowlist           # experimental upstream WeChat DM allowlist

# ──────────────────────────────────────────────────────────────────
# Web Search (optional)
# ──────────────────────────────────────────────────────────────────
# Brave and Tavily are native upstream providers.
# Valid values: brave, tavily, none
# When unset, upstream NemoClaw chooses from the available provider keys.
# Set this explicitly if both keys are present.
# NEMOCLAW_WEB_SEARCH_PROVIDER=tavily
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# ──────────────────────────────────────────────────────────────────
# OpenAI-compatible HTTP API (OpenClaw-only cookbook overlay)
# ──────────────────────────────────────────────────────────────────
# OpenClaw only: enables an OpenAI-compatible inference endpoint on the gateway:
#   POST /v1/chat/completions
#   POST /v1/responses
#   GET  /v1/models
#   POST /v1/embeddings
#
# Use it with the Python `openai` SDK, curl, or any OpenAI-compatible client.
# After deploy, OPENAI_BASE_URL and an OPENAI_API_KEY loader are written to
# ~/nemoclaw-openai.env (default base URL is http://127.0.0.1/v1, which
# works from the Brev host and from a laptop via SSH port-forward). The raw
# edge token stays in ~/.nemoclaw/openai-http-edge-token with owner-only perms.
#
# WARNING: this endpoint grants OPERATOR-LEVEL access to the sandbox.
# Treat the generated OpenAI API edge token like an owner credential.
# Rotate it without rebuilding the sandbox:
#   scripts/rotate-openai-http-token.sh
# nginx rate limits /v1/* by source IP at 120 requests per minute with a burst
# of 30 requests.
# NEMOCLAW_OPENAI_HTTP_ENABLED=1
#
# Hermes already exposes an upstream-native OpenAI-compatible API. The
# cookbook writes its allocated port and token loader to the same
# ~/nemoclaw-openai.env path without this flag. Deep Agents Code is terminal-only.

# Lift the nginx `deny all;` rule on /v1/* so non-loopback source IPs can
# reach the endpoint only when the second header credential below is configured.
# Default (unset) renders `allow 127.0.0.1; deny all;` — only loopback callers
# reach /v1/*.
#
# When to set: self-hosted deployment where nginx port 80 is exposed
# directly on the host's network interface and non-loopback clients need /v1/*.
# Those clients must send both Authorization and the CF-Access service-token
# headers configured below.
#
# When NOT to set: Brev Secure Link (any access mode), SSH port-forward,
# or any cloudflared-fronted deployment. Those surface to nginx as
# 127.0.0.1 — the existing `allow 127.0.0.1;` already covers them, so
# setting this flag changes nothing.
#
# If NEMOCLAW_OPENAI_HTTP_TUNNEL=1 is set without both access values below,
# nginx fails closed for non-loopback /v1/* callers.
# NEMOCLAW_OPENAI_HTTP_TUNNEL=1
# NEMOCLAW_OPENAI_HTTP_ACCESS_CLIENT_ID=
# NEMOCLAW_OPENAI_HTTP_ACCESS_CLIENT_SECRET=

# Bind nginx beyond loopback only when a platform service endpoint must reach
# the host network interface directly. Loopback Secure Link/cloudflared and SSH
# port-forward modes should leave this unset. Brev apps.run service endpoints
# generally need 0.0.0.0 because the ingress cannot connect to 127.0.0.1.
#
# This only exposes nginx. To expose /v1/* through that endpoint, also set
# NEMOCLAW_OPENAI_HTTP_TUNNEL=1 and the NEMOCLAW_OPENAI_HTTP_ACCESS_CLIENT_*
# values above.
# NEMOCLAW_NGINX_LISTEN_ADDR=0.0.0.0

# ──────────────────────────────────────────────────────────────────
# Network Policy (optional)
# ──────────────────────────────────────────────────────────────────
# Upstream NemoClaw owns policy selection. In suggested mode it merges required
# presets for enabled messaging channels, local inference, and native web
# search. Set these only when you want to override upstream's selection.
#
# Policy tier (restricted | balanced | open). Default: balanced.
#   restricted: inference + core tooling only
#   balanced:   + npm, pypi, huggingface, brew, selected brave/tavily web search
#   open:       + slack, discord, telegram, jira, outlook
# NEMOCLAW_POLICY_TIER=balanced

# Policy presets (comma-separated). Overrides tier defaults when set.
# Available presets depend on the upstream release. Common names include:
# pypi, npm, telegram, discord, slack, wechat, whatsapp, brave, tavily, brew,
# docker, huggingface, local-inference, jira, outlook
# NEMOCLAW_POLICY_PRESETS=pypi,npm,telegram,brave

# Policy mode (suggested | custom | skip). Default: suggested.
#   suggested: tier defaults, with NEMOCLAW_POLICY_PRESETS as override
#   custom:    only use NEMOCLAW_POLICY_PRESETS (required)
#   skip:      no policy presets applied
# NEMOCLAW_POLICY_MODE=suggested

# ──────────────────────────────────────────────────────────────────
# Advanced (optional)
# ──────────────────────────────────────────────────────────────────
# NEMOCLAW_RECREATE_SANDBOX=1
# NEMOCLAW_GPU=a2-highgpu-1g:nvidia-tesla-a100:1
# NEMOCLAW_DASHBOARD_PORT=18789           # OpenClaw or Hermes; auto-allocates by default
# NEMOCLAW_HERMES_API_PORT=8642           # Hermes only; auto-allocates by default
# NEMOCLAW_HERMES_DASHBOARD_TUI=1         # Hermes optional dashboard TUI tab
# NEMOCLAW_TOOL_DISCLOSURE=progressive    # progressive or direct
# NEMOCLAW_DCODE_AUTO_APPROVAL=disabled   # disabled or thread-opt-in
# NEMOCLAW_REASONING_EFFORT=default        # default, low, medium, or high
# ENABLE_TERMINAL_SERVER=true
# TUNNEL_FQDN=your-secure-link.brevlab.com
# CHAT_UI_URL=https://your-domain.example.com
# CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-named-tunnel-token
# NEMOCLAW_WECHAT_QUIET=1
