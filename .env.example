# ──────────────────────────────────────────────────────────────────
# NVIDIA Inference (required)
# ──────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-your-key-here

# Inference provider (optional — defaults to NVIDIA cloud)
# Valid values: build (NVIDIA cloud), openai, anthropic, anthropicCompatible,
#               gemini, ollama, custom, nim-local, vllm
# NEMOCLAW_PROVIDER=build

# Inference model (optional — defaults to nvidia/nemotron-3-super-120b-a12b)
# Must match the provider. You can switch at runtime without rebuilding:
#   openshell inference set --provider nvidia-prod --model <model>
# NEMOCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b

# Custom inference endpoint (optional — for custom/nim-local/vllm providers)
# NEMOCLAW_ENDPOINT_URL=http://localhost:8000/v1

# Sandbox resources (optional)
# View upstream profiles with: nemoclaw resources
# NEMOCLAW_RESOURCE_PROFILE=developer
# NEMOCLAW_CPU=75%
# NEMOCLAW_RAM=75%

# Alternative inference provider keys (optional — set with matching NEMOCLAW_PROVIDER)
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ──────────────────────────────────────────────────────────────────
# Messaging (optional)
# ──────────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# TELEGRAM_ALLOWED_IDS=your-chat-id-from-userinfobot  # comma-separated; restricts who can DM the bot
# TELEGRAM_REQUIRE_MENTION=1                          # group chats only; 1 requires @mention, 0 replies to all group messages
# DISCORD_BOT_TOKEN=your-discord-bot-token
# DISCORD_SERVER_ID=your-discord-server-id
# DISCORD_ALLOWED_IDS=your-discord-user-id            # comma-separated; DISCORD_USER_ID also works upstream
# DISCORD_REQUIRE_MENTION=1                           # 1 requires @mention, 0 replies to all configured server messages
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_APP_TOKEN=xapp-your-slack-app-token            # required by upstream Slack Socket Mode
# SLACK_ALLOWED_USERS=U012ABCDEF,U987ZYXW              # optional member allowlist
# SLACK_ALLOWED_CHANNELS=C012AB3CD,C987ZY6XW           # optional channel allowlist for @mentions
# WECHAT_ALLOWED_IDS=wxid-optional-allowlist           # experimental upstream WeChat DM allowlist

# ──────────────────────────────────────────────────────────────────
# Web Search (optional)
# ──────────────────────────────────────────────────────────────────
# Brave is native upstream. Tavily is a cookbook overlay until NemoClaw ships it.
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ──────────────────────────────────────────────────────────────────
# OpenAI-compatible HTTP API (optional)
# ──────────────────────────────────────────────────────────────────
# Enables an OpenAI-compatible inference endpoint on the gateway:
#   POST /v1/chat/completions
#   POST /v1/responses
#   GET  /v1/models
#   POST /v1/embeddings
#
# Use it with the Python `openai` SDK, curl, or any OpenAI-compatible client.
# After deploy, OPENAI_BASE_URL and OPENAI_API_KEY are written to
# ~/openclaw-openai.env (default base URL is http://127.0.0.1/v1, which
# works from the Brev host and from a laptop via SSH port-forward).
#
# WARNING: this endpoint grants OPERATOR-LEVEL access to the sandbox.
# Treat the gateway token like an owner credential.
# NEMOCLAW_OPENAI_HTTP_ENABLED=1

# Lift the nginx `deny all;` rule on /v1/* so non-loopback source IPs
# can reach the endpoint. Default (unset) renders `allow 127.0.0.1;
# deny all;` — only loopback callers reach /v1/*.
#
# When to set: self-hosted deployment where nginx port 80 is exposed
# directly on the host's network interface (no cloudflared, no SSH
# port-forward, no fronting reverse proxy), and you want remote
# clients to hit /v1/* with only the gateway token as auth.
#
# When NOT to set: Brev Secure Link (any access mode), SSH port-forward,
# or any cloudflared-fronted deployment. Those surface to nginx as
# 127.0.0.1 — the existing `allow 127.0.0.1;` already covers them, so
# setting this flag changes nothing.
#
# Trade-off when enabled: removes the IP allowlist; the gateway token
# is the only auth layer. Pair with TLS termination and rate limiting
# at the network edge.
# NEMOCLAW_OPENAI_HTTP_TUNNEL=1

# ──────────────────────────────────────────────────────────────────
# Network Policy (optional)
# ──────────────────────────────────────────────────────────────────
# Upstream NemoClaw owns policy selection. In suggested mode it merges required
# presets for enabled messaging channels, local inference, and native Brave
# search. Set these only when you want to override upstream's selection.
#
# Policy tier (restricted | balanced | open). Default: balanced.
#   restricted: inference + core tooling only
#   balanced:   + npm, pypi, huggingface, brew, brave
#   open:       + slack, discord, telegram, jira, outlook
# NEMOCLAW_POLICY_TIER=balanced

# Policy presets (comma-separated). Overrides tier defaults when set.
# Available presets depend on the upstream release. Common names include:
# pypi, npm, telegram, discord, slack, wechat, whatsapp, brave, brew,
# docker, huggingface, local-inference, jira, outlook
# NEMOCLAW_POLICY_PRESETS=pypi,npm,telegram,brave

# Policy mode (suggested | custom | skip). Default: suggested.
#   suggested: tier defaults, with NEMOCLAW_POLICY_PRESETS as override
#   custom:    only use NEMOCLAW_POLICY_PRESETS (required)
#   skip:      no policy presets applied
# NEMOCLAW_POLICY_MODE=suggested

# ──────────────────────────────────────────────────────────────────
# Advanced (optional)
# ──────────────────────────────────────────────────────────────────
# NEMOCLAW_SANDBOX_NAME=my-assistant
# NEMOCLAW_RECREATE_SANDBOX=1
# NEMOCLAW_GPU=a2-highgpu-1g:nvidia-tesla-a100:1
# ENABLE_TERMINAL_SERVER=true
# TUNNEL_FQDN=your-secure-link.brevlab.com
# CHAT_UI_URL=https://your-domain.example.com
# CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-named-tunnel-token
# NEMOCLAW_WECHAT_QUIET=1
